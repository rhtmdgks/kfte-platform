# Naver Maps API v3 (NCP 통합 키 = ncpKeyId)
# 콘솔: https://console.ncloud.com/ → AI·NAVER API → Maps
# 문서: https://navermaps.github.io/maps.js.ncp/docs/tutorial-2-Getting-Started.html
# Web 서비스 URL 예시: http://localhost:3000, https://kfte.kr
NEXT_PUBLIC_NAVER_MAP_NCP_KEY_ID=
# Client Secret은 브라우저에 넣지 마세요. (서버 REST API 필요 시에만)
# NAVER_MAP_CLIENT_SECRET=
# (하위 호환) 기존 변수명도 인식합니다
# NEXT_PUBLIC_NAVER_MAP_CLIENT_ID=

# Supabase — https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 프로덕션 도메인 — canonical / sitemap / OG 기준 URL
NEXT_PUBLIC_SITE_URL=https://kfte.kr
